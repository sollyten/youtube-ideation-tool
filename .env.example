# SERVER-SIDE ENV for the HOSTED, MULTI-USER company tool.
# These are COMPANY keys, configured once by an admin, used by all authenticated
# directors. They live ONLY on the server and are NEVER exposed to the browser or to
# individual users. Do not commit the real .env.

# --- Company-provisioned API keys (shared across all users) ---
YOUTUBE_API_KEY=company_youtube_data_api_v3_key          # public data (competitors, titles)
PERPLEXITY_API_KEY=company_perplexity_api_key            # research
ANTHROPIC_API_KEY=company_anthropic_api_key              # reasoning steps (prompts 02,04,05,06)
HIGGSFIELD_API_KEY=company_higgsfield_key                # thumbnail-lab only

# --- Auth / sessions ---
AUTH_SECRET=long_random_session_secret
# (configure your auth provider here: email+password, Google Workspace SSO, etc.)

# --- Database (multi-user requires a real DB, not flat files) ---
DATABASE_URL=postgres://user:pass@host:5432/creatortool

# --- Secrets encryption (for per-user YouTube OAuth tokens at rest) ---
TOKEN_ENCRYPTION_KEY=32_byte_key_for_encrypting_oauth_tokens_at_rest

# --- Google OAuth client (so directors can connect their own channels) ---
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...
GOOGLE_OAUTH_REDIRECT_URI=https://yourtool.example.com/oauth/youtube/callback

# NOTE: the reasoning steps run SERVER-SIDE through the company ANTHROPIC_API_KEY. There
# is no "Claude Code subscription" mode in the hosted product (a personal subscription
# cannot be shared across users). All director usage bills to the company Anthropic
# account.
