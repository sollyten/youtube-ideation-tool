# SERVER-SIDE ENV for the HOSTED, MULTI-USER company tool.
# These are COMPANY keys, configured once by an admin, used by all authenticated
# directors. They live ONLY on the server and are NEVER exposed to the browser or to
# individual users. Do not commit the real .env.

# --- Company-provisioned API keys (shared across all users) ---
YOUTUBE_API_KEY=company_youtube_data_api_v3_key          # public data (competitors, titles)
PERPLEXITY_API_KEY=company_perplexity_api_key            # research (Sonar + Agent APIs)
ANTHROPIC_API_KEY=company_anthropic_api_key              # reasoning steps (prompts 02,04,05,06)
HIGGSFIELD_API_KEY=company_higgsfield_key                # thumbnail-lab only (HTTP mode)

# --- Thumbnail Lab → Higgsfield transport (thumbnail-lab only) ---
# HIGGSFIELD_ADAPTER selects how the isolated Thumbnail Lab reaches Higgsfield:
#   http (default)  -> REST API using HIGGSFIELD_API_KEY above
#   mcp             -> a Higgsfield MCP server (fill in the block below)
#   stub            -> keyless local dev / tests
# HIGGSFIELD_ADAPTER=mcp
# HIGGSFIELD_MCP_URL=https://mcp.higgsfield.example/mcp   # Streamable HTTP MCP endpoint
# HIGGSFIELD_MCP_TOKEN=bearer_token_if_required
# Tool + argument names are configurable to match the server's actual schema:
# HIGGSFIELD_MCP_TOOL=generate_image
# HIGGSFIELD_MCP_PROMPT_ARG=prompt
# HIGGSFIELD_MCP_MODEL_ARG=model
# HIGGSFIELD_MCP_REFERENCES_ARG=reference_images
# HIGGSFIELD_MCP_ATTACHED_ARG=attached_image

# --- Perplexity routing (research) ---
# Idea Generation (prompt 01) uses the Sonar API; the model is selectable per run
# in the UI (sonar-pro | sonar-deep-research). This is the default when a run
# doesn't specify one:
# PERPLEXITY_IDEATION_MODEL=sonar-deep-research
# Deep Competitor Analysis (prompt 03) uses the Agent API (OpenAI Responses
# format: a single `input` string + provider-prefixed model). Endpoint path +
# model are configurable so they can be matched to the live API. The model must
# be a provider-prefixed id from GET /v1/models, NOT a bare Sonar name:
# PERPLEXITY_AGENT_PATH=/v1/agent
# PERPLEXITY_AGENT_MODEL=perplexity/sonar   # e.g. perplexity/sonar, anthropic/claude-opus-4-8
# PERPLEXITY_BASE_URL=https://api.perplexity.ai
# PERPLEXITY_TIMEOUT_MS=480000   # deep-research/agent runs can take minutes

# --- Auth / sessions ---
AUTH_SECRET=long_random_session_secret
# (configure your auth provider here: email+password, Google Workspace SSO, etc.)

# --- Database (multi-user requires a real DB, not flat files) ---
DATABASE_URL=postgres://user:pass@host:5432/creatortool

# --- Secrets encryption (for per-user YouTube OAuth tokens at rest) ---
TOKEN_ENCRYPTION_KEY=32_byte_key_for_encrypting_oauth_tokens_at_rest

# --- Google OAuth client (so directors can connect their own channels) ---
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...
# Defaults to ${APP_BASE_URL}/api/oauth/youtube/callback when omitted.
GOOGLE_OAUTH_REDIRECT_URI=https://yourtool.example.com/api/oauth/youtube/callback

# --- App base URL (used for OAuth redirect + post-connect redirects) ---
APP_BASE_URL=http://localhost:3000

# --- Optional tuning (sane defaults; override only if needed) ---
# Per-user daily quotas on the expensive actions:
# QUOTA_IDEATION_PER_DAY=10
# QUOTA_COMPETITOR_PER_DAY=10
# QUOTA_RETENTION_PER_DAY=20
# QUOTA_PERFORMANCE_PER_DAY=20
# QUOTA_PROFILE_BUILD_PER_DAY=20
# Adapters — set to "stub" for keyless local dev / tests:
# REASONING_ADAPTER=anthropic
# HIGGSFIELD_ADAPTER=http
# HIGGSFIELD_ENDPOINT=https://api.higgsfield.ai/v1/images/generate

# NOTE: the reasoning steps run SERVER-SIDE through the company ANTHROPIC_API_KEY. There
# is no "Claude Code subscription" mode in the hosted product (a personal subscription
# cannot be shared across users). All director usage bills to the company Anthropic
# account.
